</div>


<script>

/* FORMULA DATABASE */

const formulas = [

{
id:1,
name:"Quadratic Function",
subject:"Differential Calculus",
formula:"y = x²",
description:"A quadratic function creates a parabolic curve.",
type:"quadratic"
},

{
id:2,
name:"Linear Function",
subject:"Differential Calculus",
formula:"y = ax + b",
description:"A linear equation produces a straight line.",
type:"linear"
},

{
id:3,
name:"Cubic Function",
subject:"Differential Calculus",
formula:"y = x³",
description:"A cubic function produces an S-shaped curve.",
type:"cubic"
},

{
id:4,
name:"Sine Function",
subject:"Trigonometry",
formula:"y = sin(x)",
description:"The sine function creates a periodic wave.",
type:"sine"
},

{
id:5,
name:"Cosine Function",
subject:"Trigonometry",
formula:"y = cos(x)",
description:"The cosine function creates a periodic wave.",
type:"cosine"
},

{
id:6,
name:"Exponential Function",
subject:"Differential Calculus",
formula:"y = eˣ",
description:"An exponential function represents rapid growth.",
type:"exponential"
},

{
id:7,
name:"Power Rule",
subject:"Differential Calculus",
formula:"d/dx(xⁿ) = nxⁿ⁻¹",
description:"The derivative of x raised to a power.",
type:"power"
},

{
id:8,
name:"Derivative of Sin x",
subject:"Differential Calculus",
formula:"d/dx(sin x) = cos x",
description:"The derivative of sine is cosine.",
type:"sine"
},

{
id:9,
name:"Integral of x²",
subject:"Integral Calculus",
formula:"∫x² dx = x³/3 + C",
description:"Integration increases the power by one and divides by the new power.",
type:"integral"
},

{
id:10,
name:"Integral of Sin x",
subject:"Integral Calculus",
formula:"∫sin x dx = -cos x + C",
description:"The integral of sine is negative cosine.",
type:"sine"
},

{
id:11,
name:"First Order Linear DE",
subject:"Differential Equations",
formula:"dy/dx + Py = Q",
description:"A first-order linear differential equation.",
type:"linear"
},

{
id:12,
name:"Determinant",
subject:"Matrices",
formula:"|A| = ad - bc",
description:"Determinant of a 2 × 2 matrix.",
type:"quadratic"
},

{
id:13,
name:"Eigenvalue Equation",
subject:"Matrices",
formula:"|A - λI| = 0",
description:"The characteristic equation used to calculate eigenvalues.",
type:"quadratic"
},

{
id:14,
name:"Laplace Transform of Sin at",
subject:"Laplace Transforms",
formula:"L{sin at} = a/(s²+a²)",
description:"Laplace transform of a sine function.",
type:"laplace"
},

{
id:15,
name:"Laplace Transform of Cos at",
subject:"Laplace Transforms",
formula:"L{cos at} = s/(s²+a²)",
description:"Laplace transform of a cosine function.",
type:"laplace"
}

];


/* VARIABLES */

let selectedType = "quadratic";
let selectedFormula = formulas[0];
let favorites = JSON.parse(localStorage.getItem("favorites")) || [];
let showOnlyFavorites = false;

let chart;


/* DISPLAY FORMULAS */

function displayFormulas(){

    const search =
    document.getElementById("search").value.toLowerCase();

    const filter =
    document.getElementById("filter").value;

    let result = formulas.filter(item => {

        const matchSearch =
        item.name.toLowerCase().includes(search) ||
        item.formula.toLowerCase().includes(search);

        const matchCategory =
        filter === "all" || item.subject === filter;

        const matchFavorite =
        !showOnlyFavorites || favorites.includes(item.id);

        return matchSearch && matchCategory && matchFavorite;

    });

    const list = document.getElementById("formulaList");

    list.innerHTML = "";

    if(result.length === 0){

        list.innerHTML = `
            <p style="padding:20px;color:#927bb5">
                No formulas found. Try another search 💜
            </p>
        `;

        return;

    }

    result.forEach(item => {

        const isFavorite = favorites.includes(item.id);

        list.innerHTML += `

        <div class="formula-card">

            <span class="subject">${item.subject}</span>

            <h3>${item.name}</h3>

            <div class="formula">
                ${item.formula}
            </div>

            <p>${item.description}</p>

            <div class="card-actions">

                <button class="btn view-btn"
                onclick="visualize(${item.id})">
                    📈 Visualize
                </button>

                <button class="btn fav-btn"
                onclick="toggleFavorite(${item.id})">
                    ${isFavorite ? "❤️" : "🤍"}
                </button>

            </div>

        </div>

        `;

    });

    document.getElementById("totalCount").textContent =
        formulas.length;

    document.getElementById("favoriteCount").textContent =
        favorites.length;

}


/* CATEGORY FILTER */

function selectCategory(category,element){

    showOnlyFavorites = false;

    document.getElementById("filter").value = category;

    document.querySelectorAll(".category").forEach(item => {
        item.classList.remove("active");
    });

    element.classList.add("active");

    displayFormulas();

}


/* FAVORITES */

function toggleFavorite(id){

    if(favorites.includes(id)){

        favorites = favorites.filter(item => item !== id);

    }else{

        favorites.push(id);

    }

    localStorage.setItem(
        "favorites",
        JSON.stringify(favorites)
    );

    displayFormulas();

}


function showFavorites(){

    showOnlyFavorites = true;

    document.getElementById("filter").value = "all";

    document.querySelectorAll(".category").forEach(item => {
        item.classList.remove("active");
    });

    displayFormulas();

}


/* SELECT FORMULA */

function visualize(id){

    const item = formulas.find(f => f.id === id);

    selectedFormula = item;

    selectedType = item.type;

    document.getElementById("visualTitle").textContent =
        item.name;

    document.getElementById("visualFormula").textContent =
        item.formula;

    document.getElementById("explanationText").textContent =
        item.description;

    document.getElementById("visualizer").scrollIntoView({
        behavior:"smooth"
    });

    document.getElementById("xSlider").value = 2;

    document.getElementById("aSlider").value = 1;

    updateGraph();

}


/* MATHEMATICAL FUNCTION */

function calculate(x,a){

    switch(selectedType){

        case "quadratic":
            return a*x*x;

        case "linear":
            return a*x+1;

        case "cubic":
            return a*x*x*x;

        case "sine":
            return a*Math.sin(x);

        case "cosine":
            return a*Math.cos(x);

        case "exponential":
            return Math.exp(x);

        case "power":
            return a*2*x;

        case "integral":
            return a*x*x*x/3;

        case "laplace":
            return a/(x*x+a*a);

        default:
            return x*x;

    }

}


/* GRAPH */

function updateGraph(){

    const x =
    parseFloat(document.getElementById("xSlider").value);

    const a =
    parseFloat(document.getElementById("aSlider").value);

    document.getElementById("xValue").textContent =
        x.toFixed(1);

    document.getElementById("aValue").textContent =
        a.toFixed(1);


    const labels = [];

    const values = [];

    for(let i=-5;i<=5;i+=0.1){

        const point = Number(i.toFixed(1));

        labels.push(point);

        values.push(calculate(point,a));

    }


    const currentY = calculate(x,a);

    if(chart){

        chart.destroy();

    }

    const ctx =
    document.getElementById("mathChart").getContext("2d");


    chart = new Chart(ctx,{

        type:"line",

        data:{

            labels:labels,

            datasets:[

                {

                    label:"Mathematical Function",

                    data:values,

                    borderColor:"#914aff",

                    backgroundColor:"rgba(163,74,255,0.12)",

                    borderWidth:3,

                    fill:selectedType === "integral",

                    tension:0.3,

                    pointRadius:0

                },

                {

                    label:"Selected Point",

                    data:labels.map((v,i) =>
                        Math.abs(v-x)<0.001 ? currentY : null
                    ),

                    borderColor:"#ff65a3",

                    backgroundColor:"#ff65a3",

                    pointRadius:7,

                    pointHoverRadius:9,

                    showLine:false

                }

            ]

        },

        options:{

            responsive:true,

            maintainAspectRatio:false,

            interaction:{
                intersect:false,
                mode:"index"
            },

            plugins:{

                legend:{
                    display:true
                }

            },

            scales:{

                x:{

                    title:{
                        display:true,
                        text:"X Axis"
                    }

                },

                y:{

                    title:{
                        display:true,
                        text:"Y Axis"
                    }

                }

            }

        }

    });


    updateCalculation(x,a,currentY);

}


/* CALCULATION EXPLANATION */

function updateCalculation(x,a,y){

    let message = "";

    switch(selectedType){

        case "quadratic":

            message =
            `y = ax² = ${a.toFixed(1)} × ${x.toFixed(1)}² = ${y.toFixed(2)}`;

            break;

        case "linear":

            message =
            `y = ax + 1 = ${a.toFixed(1)} × ${x.toFixed(1)} + 1 = ${y.toFixed(2)}`;

            break;

        case "cubic":

            message =
            `y = ax³ = ${a.toFixed(1)} × ${x.toFixed(1)}³ = ${y.toFixed(2)}`;

            break;

        case "sine":

            message =
            `y = ${a.toFixed(1)} × sin(${x.toFixed(1)}) = ${y.toFixed(2)}`;

            break;

        case "cosine":

            message =
            `y = ${a.toFixed(1)} × cos(${x.toFixed(1)}) = ${y.toFixed(2)}`;

            break;

        case "exponential":

            message =
            `y = e^${x.toFixed(1)} = ${y.toFixed(2)}`;

            break;

        case "power":

            message =
            `d/dx(ax²) = 2ax = ${y.toFixed(2)}`;

            break;

        case "integral":

            message =
            `∫ax² dx = ax³/3 = ${y.toFixed(2)}`;

            break;

        case "laplace":

            message =
            `L{sin(at)} = a/(s²+a²) = ${y.toFixed(2)} (taking s = ${x.toFixed(1)})`;

            break;

    }

    document.getElementById("calculation").textContent =
        message;

}


