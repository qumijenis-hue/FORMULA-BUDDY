<!-- Navbar -->

<nav class="navbar">

    <div class="logo">
        🎓 Formula <span>Buddy</span>
    </div>

    <div class="nav-links">
        <a href="#">Home</a>
        <a href="#formulas">Formulas</a>
        <a href="#visualizer">Visualizer</a>
        <a href="#about">About</a>
    </div>

    <div class="profile">
