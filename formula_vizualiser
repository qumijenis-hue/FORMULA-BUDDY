</nav>


<div class="container">

    <!-- Hero -->

    <section class="hero">

        <div>
            <h1>Formula Visualizer 💜</h1>

            <p>
                Don't just memorize formulas. See how mathematics works!
            </p>

            <p>
                ✨ Explore • Visualize • Understand • Excel
            </p>
        </div>

        <div class="hero-icon">
