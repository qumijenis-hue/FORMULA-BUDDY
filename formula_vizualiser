<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Formula Buddy 💜 | Visualizer</title>
  <link rel="stylesheet" href="style2.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
 
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar">
    <div class="logo">Formula Buddy 💜</div>
    <div>
      <a href="index.html">Home</a>
      <a href="Formula_of_the_day.html">Formula of the Day</a>
       <a href="Revise_calender.html">Revise Calender</a>

      <a href="visualizer.html" class="active">Visualizer</a>
    </div>
  </nav>
  <main class="container">
    <!-- Page Heading -->
    <div class="page-heading">
      <h1>Formula Visualizer</h1>
      <p>Explore mathematical formulas through interactive graphs.</p>
    </div>
    <!-- Formula Selection -->
    <div class="formula-select">
      <label for="formulaSelect">Choose a formula</label>
      <select id="formulaSelect">
        <option value="quadratic">Quadratic Function — y = ax²</option>
        <option value="linear">Linear Function — y = ax + b</option>
        <option value="cubic">Cubic Function — y = ax³</option>
        <option value="sine">Sine Function — y = sin(x)</option>
        <option value="cosine">Cosine Function — y = cos(x)</option>
        <option value="integral">Integral — ∫x² dx = x³/3 + C</option>
      </select>
    </div>
    <div class="visualizer-layout">
      <!-- Controls -->
      <section class="card">
        <h2>Formula Controls</h2>
        <div class="formula-box">
          <h3 id="formulaEquation">y = ax²</h3>
          <p id="formulaName">Quadratic Function</p>
        </div>
        <div class="control">
          <div class="control-header">
            <span>Parameter A</span>
            <span id="aValue">1</span>
          </div>
          <input
            type="range"
            id="aSlider"
            min="-5"
            max="5"
            step="0.5"
            value="1"
          >
        </div>
        <div class="control" id="bControl">
          <div class="control-header">
            <span>Parameter B</span>
            <span id="bValue">1</span>
          </div>
          <input
            type="range"
            id="bSlider"
            min="-5"
            max="5"
            step="0.5"
            value="1"
          >
        </div>
        <div class="control">
          <div class="control-header">
            <span>X Value</span>
            <span id="xValue">2</span>
          </div>
          <input
            type="range"
            id="xSlider"
            min="-5"
            max="5"
            step="0.5"
            value="2"
          >
        </div>
        <div class="result-box">
          <p>Calculated Y Value</p>
          <h3 id="result">4</h3>
        </div>
        <div class="buttons">
          <button class="primary-btn" id="resetBtn">Reset</button>
          <button class="secondary-btn" id="practiceBtn">
            Practice
          </button>
        </div>
      </section>
      <!-- Graph -->
      <section class="card graph-card">
        <h2>Graph Visualization</h2>
        <div class="graph-container">
          <canvas id="formulaChart"></canvas>
        </div>
        <div class="explanation">
          <strong>How it works:</strong>
          <p id="explanationText">
            A quadratic function creates a parabolic curve.
            Changing parameter A changes the direction and width
            of the parabola.
          </p>
        </div>
      </section>
    </div>
    <!-- Practice Section -->
    <section class="practice">
      <div>
        <h3>Test Your Understanding</h3>
        <p id="practiceQuestion">
          What is the value of y when x = 3?
        </p>
      </div>
      <button class="primary-btn" id="showAnswerBtn">
        Show Answer
      </button>
    </section>
  </main>
  <script>
    const formulaSelect = document.getElementById("formulaSelect");
    const aSlider = document.getElementById("aSlider");
    const bSlider = document.getElementById("bSlider");
    const xSlider = document.getElementById("xSlider");
    const aValue = document.getElementById("aValue");
    const bValue = document.getElementById("bValue");
    const xValue = document.getElementById("xValue");
    const formulaEquation = document.getElementById("formulaEquation");
    const formulaName = document.getElementById("formulaName");
    const result = document.getElementById("result");
    const explanationText = document.getElementById("explanationText");
    const bControl = document.getElementById("bControl");
    const formulas = {
      quadratic: {
        name: "Quadratic Function",
        equation: "y = ax²",
        explanation:
          "A quadratic function creates a parabolic curve. Positive A opens upward, while negative A opens downward."
      },
      linear: {
        name: "Linear Function",
        equation: "y = ax + b",
        explanation:
          "A linear function creates a straight line. Parameter A controls the slope, while B controls the vertical position."
      },
      cubic: {
        name: "Cubic Function",
        equation: "y = ax³",
        explanation:
          "A cubic function creates an S-shaped curve. Changing A affects its steepness and direction."
      },
      sine: {
        name: "Sine Function",
        equation: "y = sin(x)",
        explanation:
          "The sine function creates a repeating wave. Its values range between -1 and 1."
      },
      cosine: {
        name: "Cosine Function",
        equation: "y = cos(x)",
        explanation:
          "The cosine function creates a repeating wave that begins at 1 when x = 0."
      },
      integral: {
        name: "Integral of x²",
        equation: "y = ax³/3",
        explanation:
          "Integration finds the accumulated area under a curve. The integral of x² is x³/3 + C."
      }
    };
    function calculateY(x, a, b, type) {
      switch (type) {
        case "quadratic":
          return a * x * x;
        case "linear":
          return a * x + b;
        case "cubic":
          return a * x * x * x;
        case "sine":
          return Math.sin(x);
        case "cosine":
          return Math.cos(x);
        case "integral":
          return a * x * x * x / 3;
        default:
          return 0;
      }
    }
    const ctx = document.getElementById("formulaChart");
    const chart = new Chart(ctx, {
      type: "line",
      data: {
        datasets: [
          {
            label: "Function",
            data: [],
            borderColor: "#8b6cf0",
            backgroundColor: "rgba(139, 108, 240, 0.12)",
            borderWidth: 3,
            pointRadius: 0,
            tension: 0.2,
            fill: true
          },
          {
            label: "Selected Point",
            data: [],
            borderColor: "#ff8fab",
            backgroundColor: "#ff8fab",
            pointRadius: 7,
            pointHoverRadius: 9,
            showLine: false
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: {
          intersect: false,
          mode: "index"
        },
        scales: {
          x: {
            type: "linear",
            title: {
              display: true,
              text: "X"
            },
            min: -5,
            max: 5,
            grid: {
              color: "#eee8ff"
            }
          },
          y: {
            title: {
              display: true,
              text: "Y"
            },
            min: -10,
            max: 10,
            grid: {
              color: "#eee8ff"
            }
          }
        },
        plugins: {
          legend: {
            display: false
          }
        }
      }
    });
    function updateVisualizer() {
      const type = formulaSelect.value;
      const a = Number(aSlider.value);
      const b = Number(bSlider.value);
      const x = Number(xSlider.value);
      const y = calculateY(x, a, b, type);
      aValue.textContent = a;
      bValue.textContent = b;
      xValue.textContent = x;
      result.textContent = Number(y.toFixed(4));
      formulaEquation.textContent = formulas[type].equation;
      formulaName.textContent = formulas[type].name;
      explanationText.textContent = formulas[type].explanation;
      // Parameter B is used only by the linear function.
      bControl.style.display = type === "linear" ? "block" : "none";
      // Generate graph points.
      const points = [];
      for (let i = -5; i <= 5; i += 0.1) {
        points.push({
          x: Number(i.toFixed(2)),
          y: calculateY(i, a, b, type)
        });
      }
      chart.data.datasets[0].data = points;
      // Highlight the selected point.
      chart.data.datasets[1].data = [
        {
          x: x,
          y: y
        }
      ];
      chart.update();
    }
    // Update graph when sliders change.
    aSlider.addEventListener("input", updateVisualizer);
    bSlider.addEventListener("input", updateVisualizer);
    xSlider.addEventListener("input", updateVisualizer);
    formulaSelect.addEventListener("change", updateVisualizer);
    // Reset controls.
    document.getElementById("resetBtn").addEventListener("click", () => {
      formulaSelect.value = "quadratic";
      aSlider.value = 1;
      bSlider.value = 1;
      xSlider.value = 2;
      updateVisualizer();
    });
    // Practice question.
    document.getElementById("practiceBtn").addEventListener("click", () => {
      const type = formulaSelect.value;
      const a = Number(aSlider.value);
      const b = Number(bSlider.value);
      const answer = calculateY(3, a, b, type);
      document.getElementById("practiceQuestion").textContent =
        `What is the value of y when x = 3 for ${formulas[type].equation}?`;
      document.getElementById("showAnswerBtn").textContent =
        `Show Answer (${Number(answer.toFixed(4))})`;
    });
    document.getElementById("showAnswerBtn").addEventListener("click", () => {
      const type = formulaSelect.value;
      const a = Number(aSlider.value);
      const b = Number(bSlider.value);
      const answer = calculateY(3, a, b, type);
      alert(`The answer is ${Number(answer.toFixed(4))}`);
    });
    // Initial render.
    updateVisualizer();
  </script>
</body>
</html>
