        </div>

        <div class="stat-card">
            <h2 id="favoriteCount">0</h2>
            <p>Favourite Formulas</p>
        </div>

        <div class="stat-card">
            <h2>6</h2>
            <p>Maths Categories</p>
        </div>

    </div>


    <!-- Search -->

    <div class="search-area">

