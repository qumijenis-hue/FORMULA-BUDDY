<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Formula Buddy 💜 | Formula Visualizer</title>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{
    background:linear-gradient(135deg,#f8edff,#eee3ff,#fceaff);
    color:#30205e;
    min-height:100vh;
}

/* Floating symbols */

.math{
    position:fixed;
    color:#a87bff;
    opacity:.2;
    font-size:35px;
    font-weight:bold;
    pointer-events:none;
    animation:float 5s infinite ease-in-out;
    z-index:-1;
}

.math1{top:15%;left:3%}
.math2{top:45%;right:4%}
.math3{bottom:10%;left:5%}
.math4{bottom:20%;right:8%}

@keyframes float{
    50%{transform:translateY(-20px) rotate(10deg)}
}

/* Navbar */

.navbar{
    width:92%;
    max-width:1350px;
    margin:20px auto;
    background:white;
    padding:15px 25px;
    border-radius:50px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    box-shadow:0 8px 30px #9c70d520;
}

.logo{
    font-size:23px;
    font-weight:800;
    color:#4c25c7;
}

.logo span{
    color:#ff9e35;
}

.nav-links{
    display:flex;
    gap:25px;
    align-items:center;
}

.nav-links a{
    text-decoration:none;
    color:#57417e;
    font-weight:500;
}

.nav-links a:hover{
    color:#a34aff;
}

.profile{
    background:#f1e8ff;
    padding:10px 17px;
    border-radius:30px;
    color:#7135d5;
    font-weight:600;
}

/* Main container */

.container{
    width:92%;
    max-width:1350px;
    margin:35px auto;
}

/* Hero */

.hero{
    background:linear-gradient(135deg,#a34aff,#6335ec);
    padding:35px;
    border-radius:30px;
    color:white;
    display:flex;
    justify-content:space-between;
    align-items:center;
    box-shadow:0 15px 35px #8545db35;
}

.hero h1{
    font-size:38px;
}

.hero p{
    margin-top:10px;
    opacity:.9;
}

.hero-icon{
    font-size:75px;
    animation:bounce 3s infinite;
}

@keyframes bounce{
    50%{transform:translateY(-12px)}
}

/* Search */

.search-area{
    display:flex;
    gap:15px;
    margin:30px 0;
}

.search-area input{
    flex:1;
    padding:15px 20px;
    border:2px solid #eadcff;
    border-radius:15px;
    outline:none;
    background:white;
    font-size:14px;
}

.search-area input:focus{
    border-color:#a34aff;
}

.search-area select{
    padding:15px;
    border-radius:15px;
    border:2px solid #eadcff;
    background:white;
    color:#6335ec;
    font-weight:600;
}

/* Dashboard layout */

.dashboard{
    display:grid;
    grid-template-columns:250px 1fr;
    gap:25px;
}

/* Sidebar */

.sidebar{
    background:white;
    padding:25px;
    border-radius:25px;
    box-shadow:0 8px 25px #9c70d515;
    height:max-content;
}

.sidebar h3{
    margin-bottom:20px;
    color:#4c25c7;
}

.category{
    padding:13px;
    margin:8px 0;
    border-radius:12px;
    cursor:pointer;
    color:#745c99;
    transition:.3s;
    font-size:14px;
}

.category:hover,
.category.active{
    background:linear-gradient(135deg,#a34aff,#6335ec);
    color:white;
}

/* Formula cards */

.formula-section h2{
    margin-bottom:20px;
}

.formula-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:18px;
}

.formula-card{
    background:white;
    padding:23px;
    border-radius:22px;
    box-shadow:0 8px 25px #9c70d515;
    transition:.3s;
    border:2px solid transparent;
}

.formula-card:hover{
    transform:translateY(-5px);
    border-color:#d7b7ff;
}

.formula-card h3{
    font-size:16px;
    margin-bottom:10px;
}

.formula-card .subject{
    display:inline-block;
    background:#f1e8ff;
    color:#833de5;
    padding:5px 12px;
    border-radius:20px;
    font-size:11px;
    margin-bottom:15px;
}

.formula{
    background:#f8f1ff;
    padding:17px;
    text-align:center;
    border-radius:15px;
    color:#7135d5;
    font-size:19px;
    font-weight:700;
    margin:10px 0;
    overflow-wrap:anywhere;
}

.formula-card p{
    font-size:12px;
    color:#8978a7;
    margin:10px 0;
}

.card-actions{
    display:flex;
    gap:10px;
    margin-top:15px;
}

.btn{
    border:none;
    padding:10px 15px;
    border-radius:10px;
    cursor:pointer;
    font-weight:600;
    transition:.3s;
}

.view-btn{
    background:linear-gradient(135deg,#a34aff,#6335ec);
    color:white;
    flex:1;
}

.view-btn:hover{
    transform:scale(1.04);
}

.fav-btn{
    background:#fff0f5;
    color:#ff4d91;
    font-size:18px;
}

/* Visualizer */

.visualizer{
    margin-top:35px;
    background:white;
    padding:28px;
    border-radius:28px;
    box-shadow:0 10px 30px #9c70d520;
}

.visualizer-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    flex-wrap:wrap;
    gap:10px;
    margin-bottom:20px;
}

.visualizer-header h2{
    color:#4c25c7;
}

.live-tag{
    background:#e8fff1;
    color:#26965a;
    padding:7px 14px;
    border-radius:20px;
    font-size:12px;
    font-weight:600;
}

.graph-container{
    background:#faf7ff;
    border-radius:20px;
    padding:20px;
    height:350px;
    position:relative;
}

/* Controls */

.controls{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:20px;
    margin-top:25px;
}

.control-box{
    background:#f8f1ff;
    padding:18px;
    border-radius:16px;
}

.control-box label{
    display:flex;
    justify-content:space-between;
    font-size:13px;
    font-weight:600;
    margin-bottom:15px;
}

.control-box input{
    width:100%;
    accent-color:#914aff;
    cursor:pointer;
}

/* Explanation */

.explanation{
    background:linear-gradient(135deg,#f3e7ff,#fff0f8);
    margin-top:25px;
    padding:25px;
    border-radius:20px;
}

.explanation h3{
    color:#7135d5;
    margin-bottom:12px;
}

.explanation p{
    font-size:14px;
    line-height:1.9;
    color:#725d92;
}

.calculation{
    background:white;
    padding:15px;
    border-radius:12px;
    margin-top:15px;
    color:#7135d5;
    font-weight:600;
    overflow-wrap:anywhere;
}

/* Action buttons */

.action-buttons{
    display:flex;
    gap:12px;
    margin-top:20px;
    flex-wrap:wrap;
}

.action-buttons button{
    padding:12px 20px;
    border:none;
    border-radius:12px;
    cursor:pointer;
    font-weight:600;
}

.reset-btn{
    background:#f1e8ff;
    color:#7135d5;
}

.practice-btn{
    background:linear-gradient(135deg,#a34aff,#6335ec);
    color:white;
}

/* Statistics */

.stats{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:15px;
    margin-top:30px;
}

.stat-card{
    background:white;
    padding:20px;
    text-align:center;
    border-radius:18px;
    box-shadow:0 5px 20px #9c70d515;
}

.stat-card h2{
    color:#833de5;
    font-size:28px;
}

.stat-card p{
    color:#927bb5;
    font-size:12px;
}

/* Footer */

.footer{
    text-align:center;
    padding:30px;
    color:#927bb5;
    font-size:13px;
}

/* Modal */

.modal{
    display:none;
    position:fixed;
    inset:0;
    background:#30205e88;
    z-index:10;
    justify-content:center;
    align-items:center;
    padding:20px;
}

.modal-content{
    background:white;
    padding:30px;
    border-radius:25px;
    max-width:450px;
    width:100%;
    text-align:center;
}

.modal-content h2{
    color:#7135d5;
    margin-bottom:15px;
}

.modal-content p{
    margin:15px 0;
    color:#725d92;
}

.modal-content button{
    background:#833de5;
    color:white;
    padding:12px 25px;
    border:none;
    border-radius:12px;
    cursor:pointer;
    margin-top:15px;
}

/* Responsive */

@media(max-width:900px){

    .dashboard{
        grid-template-columns:1fr;
    }

    .sidebar{
        display:flex;
        flex-wrap:wrap;
        gap:5px;
    }

    .sidebar h3{
        width:100%;
    }

    .category{
        padding:10px;
    }

}

@media(max-width:600px){

    .navbar{
        width:95%;
    }

    .nav-links{
        display:none;
    }

    .container{
        width:95%;
    }

    .hero{
        padding:25px;
    }

    .hero h1{
        font-size:27px;
    }

    .hero-icon{
        font-size:45px;
    }

    .formula-grid{
        grid-template-columns:1fr;
    }

    .controls{
        grid-template-columns:1fr;
    }

    .stats{
        grid-template-columns:1fr;
    }

    .search-area{
        flex-direction:column;
    }

    .graph-container{
        height:280px;
    }

}

</style>
</head>

<body>

